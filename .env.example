# Kopie als .env anlegen (macht scripts/setup.sh automatisch). .env nie committen.

# Wie die Workflows Claude erreichen:
#   api           direkt https://api.anthropic.com mit ANTHROPIC_API_KEY (Abrechnung über die API)
#   subscription  über die lokale Bridge (bridge/claude-bridge.mjs), die Claude Code mit
#                 deinem Claude-Abo aufruft. Kein API-Key nötig, nur lokal gedacht.
CLAUDE_MODE=subscription

# Nur für CLAUDE_MODE=api: Anthropic Console > Settings > API Keys
ANTHROPIC_API_KEY=

# Nur für CLAUDE_MODE=subscription. BRIDGE_TOKEN leer lassen: setup.sh erzeugt einen.
BRIDGE_TOKEN=
BRIDGE_PORT=8787

# Geheimer Header X-Api-Key für die Webhooks. Leer lassen: setup.sh erzeugt einen.
WEBHOOK_API_KEY=

# Verschlüsselt die Credentials in n8n. Leer lassen: setup.sh erzeugt einen.
N8N_ENCRYPTION_KEY=

# Datenbank. Standard: Postgres-Container aus docker-compose.yml.
# Für Supabase: Werte aus Project Settings > Database eintragen und DB_SSL=require setzen.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=feedback
DB_USER=triage
DB_PASSWORD=
DB_SSL=disable

# Optional: Telegram-Alarm bei priority=high (Bot über @BotFather anlegen)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
